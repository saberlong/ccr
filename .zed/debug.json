[
  {
    "label": "Debug ccr (config.toml)",
    "adapter": "CodeLLDB",
    "build": {
      "command": "cargo",
      "args": ["build"]
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/ccr.exe",
    "args": ["config.toml"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "sourceLanguages": ["rust"],
    "request": "launch",
    "env": {
      "RUST_BACKTRACE": "1",
      "RUST_LIB_BACKTRACE": "1"
    }
  },
  {
    "label": "Debug ccr (release)",
    "adapter": "CodeLLDB",
    "build": {
      "command": "cargo",
      "args": ["build", "--release"]
    },
    "program": "$ZED_WORKTREE_ROOT/target/release/ccr.exe",
    "args": ["config.toml"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "sourceLanguages": ["rust"],
    "request": "launch",
    "env": {
      "RUST_BACKTRACE": "1",
      "RUST_LIB_BACKTRACE": "1"
    }
  },
  {
    "label": "Debug ccr unit tests",
    "adapter": "CodeLLDB",
    "build": {
      "command": "cargo",
      "args": ["test", "--no-run"]
    },
    "program": "cargo",
    "args": ["test", "--", "--nocapture"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "sourceLanguages": ["rust"],
    "request": "launch",
    "env": {
      "RUST_BACKTRACE": "1",
      "RUST_LIB_BACKTRACE": "1"
    }
  }
]
